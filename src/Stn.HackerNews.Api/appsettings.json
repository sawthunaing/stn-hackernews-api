{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "HackerNews": {
    "BaseUrl": "https://hacker-news.firebaseio.com/v0/",
    "MaxConcurrentRequests": 10
  },
  "BestStories": {
    "RefreshInterval": "00:05:00",
    "FailureCooldown": "00:00:10"
  },
  "AllowedHosts": "*"
}