{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "HackerNews": {
    "BaseUrl": "https://hacker-news.firebaseio.com/v0/",
    "MaxConcurrentRequests": 10
  },
  "BestStories": {
    "RefreshInterval": "00:05:00",
    "FailureCooldown": "00:00:10"
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 10
  },
  "Caching": {
    "Provider": "Memory",
    "RedisConnectionString": "localhost:6379,abortConnect=false",
    "LocalCacheDuration": "00:00:30"
  },
  "AllowedHosts": "*"
}